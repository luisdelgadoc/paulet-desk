# Copiar a .env y rellenar. .env NUNCA se versiona (ver .gitignore).

# Supabase — Project Settings -> API -> "Publishable and secret API keys"
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# WhatsApp Cloud API — mismos valores que ya tiene Hermes en
# /root/.hermes/profiles/demo/.env. El relay los necesita para:
#   - APP_SECRET: validar la firma HMAC de cada webhook de Meta
#   - VERIFY_TOKEN: responder al challenge GET de verificacion del webhook
#   - PHONE_NUMBER_ID / ACCESS_TOKEN (Fase 8): ENVIAR mensajes salientes del
#     humano por Graph API -- antes de la Fase 8 solo Hermes enviaba, el
#     relay no necesitaba sus propias credenciales de envio.
WHATSAPP_CLOUD_APP_SECRET=xxxxx
WHATSAPP_CLOUD_VERIFY_TOKEN=xxxxx
WHATSAPP_CLOUD_PHONE_NUMBER_ID=xxxxx
WHATSAPP_CLOUD_ACCESS_TOKEN=xxxxx

# Puerto donde escucha el relay (Caddy le hace reverse proxy)
RELAY_PORT=8091

# Secreto compartido con el hook de salida de Hermes (Fase 5) para
# autenticar POST /internal/hermes-response. Generar con:
#   openssl rand -hex 32
RELAY_INTERNAL_SECRET=xxxxx
